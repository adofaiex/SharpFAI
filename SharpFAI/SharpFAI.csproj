<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net481;net6.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SharpFAI</RootNamespace>
    <AssemblyName>SharpFAI</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Version Configuration -->
    <VersionPrefix>1.1.5</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <!-- NuGet Package Configuration -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SharpFAI</PackageId>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>StArray</Authors>
    <Company>StArray</Company>
    <Product>SharpFAI</Product>
    <Description>ADOFAI Level Parse Library - A C# library for parsing and manipulating ADOFAI (A Dance of Fire and Ice) level file</Description>
    <PackageTags>ADOFAI;Game;Level;Parser;JSON</PackageTags>
    <PackageProjectUrl>https://github.com/adofaiex/SharpFAI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adofaiex/SharpFAI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright StArray© 2025</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <!--
      GPLv3 全文随包分发；PackageLicenseExpression 只给 SPDX 标识，NuGet 要求两者配套出现。
      The full GPLv3 text ships with the package: PackageLicenseExpression only carries the SPDX
      identifier, and NuGet expects the licence text alongside it.
    -->
    <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>